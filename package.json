{
  "name": "torn-detector",
  "version": "1.0.0",
  "description": "Detect if a contract has been deployed in the latest (or predefined) block from an address that was previously funded through Tornado.Cash.",
  "main": "index.ts",
  "keywords": [
    "deployment",
    "ethereum",
    "smart-contracts",
    "ethersjs",
    "tornado-cash"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcaversaccio/torn-detector.git"
  },
  "homepage": "https://github.com/pcaversaccio/torn-detector#readme",
  "bugs": {
    "url": "https://github.com/pcaversaccio/torn-detector/issues"
  },
  "author": "pcaversaccio",
  "license": "WTFPL",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test": "cross-env NODE_NO_WARNINGS=1 mocha",
    "prettier:check": "prettier -c \"**/*.{js,ts,md,json,yml,yaml}\"",
    "prettier:fix": "prettier -w \"**/*.{js,ts,md,json,yml,yaml}\"",
    "lint:check": "pnpm prettier:check && eslint .",
    "lint:fix": "pnpm prettier:fix && eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/node-fetch": "^2.6.13",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.17.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "node-fetch": "3.3.2",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "type": "module"
}
